{
  "name": "react-typescript-tanstack-react-query-template",
  "version": "1.0.0",
  "description": "React + TypeScript + Tanstack React Query Template",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve -c ./webpack/webpack.config.js",
    <#if eslint == "true">
      "eslint": "eslint -c .eslintrc.js src --fix",
    </#if>
    <#if prettier == "true">
      "prettier": "prettier --write 'src'",
    </#if>
    <#if jest == "true">
      "test": "jest --detectOpenHandles --config jest.config.js --passWithNoTests",
    </#if>
    <#if husky == "true">
      "prepare": "husky",
    </#if>
    "build": "webpack -c ./webpack/webpack.config.js --env production"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "5.40.1",
    "axios": "1.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@admiral-ds/react-ui": "8.16.0",
    "styled-components": "6.1.12"
  },
  "devDependencies": {
    <#if prettier == "true">
      "prettier": "3.3.2",
    </#if>
    <#if eslint == "true">
      "eslint": "8.57.0",
      "@typescript-eslint/eslint-plugin": "7.13.0",
      "@typescript-eslint/parser": "7.13.0",
      "eslint-plugin-import": "2.29.1",
      "eslint-plugin-react": "7.34.2",
      "eslint-plugin-react-hooks": "4.6.2",
      "eslint-plugin-unused-imports": "3.2.0",
    </#if>
    <#if eslint == "true" && prettier == "true">
      "eslint-plugin-prettier": "5.1.3",
      "eslint-config-prettier": "9.1.0",
    </#if>
    <#if jest == "true">
      "jest": "29.7.0",
      "ts-jest": "29.1.4",
      "@types/jest": "29.5.12",
    </#if>
    <#if husky == "true">
      "husky": "9.0.11",
      "lint-staged": "15.2.7",
    </#if>
    "@babel/core": "7.24.6",
    "@babel/preset-env": "7.24.6",
    "@babel/preset-react": "7.24.6",
    "@babel/preset-typescript": "7.24.6",
    "@tanstack/react-query-devtools": "5.40.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "babel-loader": "9.1.3",
    "css-loader": "7.1.2",
    "effector-logger": "0.15.0",
    "html-webpack-plugin": "5.6.0",
    "http-proxy-middleware": "3.0.0",
    "mini-css-extract-plugin": "2.9.0",
    "style-loader": "4.0.0",
    "typescript": "5.4.5",
    "webpack": "5.91.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.4",
    "@svgr/webpack": "8.1.0"
  },
  "engines": {
    "node": "18.18.0"
  }
}
